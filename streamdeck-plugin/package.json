{
  "name": "crazybatto-streamdeck-control",
  "version": "1.0.0",
  "private": true,
  "description": "Originales Stream-Deck-Plugin für das Crazy_Batto Control Center",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "validate": "streamdeck validate de.crazybatto.controlcenter.sdPlugin",
    "package": "streamdeck pack de.crazybatto.controlcenter.sdPlugin --output release --force --no-update-check --no-file-list"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "ws": "8.22.2"
  }
}
