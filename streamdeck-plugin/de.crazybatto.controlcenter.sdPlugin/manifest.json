{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "de.crazybatto.controlcenter",
  "Name": "Crazy_Batto Control Center",
  "Version": "1.0.0.0",
  "Author": "Crazy_Batto",
