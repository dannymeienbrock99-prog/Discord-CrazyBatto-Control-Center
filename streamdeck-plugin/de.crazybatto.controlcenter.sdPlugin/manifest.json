      "UUID": "de.crazybatto.controlcenter.spotify.toggle",
      "Icon": "imgs/play",
      "Tooltip": "Spotify · Wiedergabe",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "States": [
        {
          "Image": "imgs/play",
          "TitleAlignment": "bottom",
          "TitleColor": "#f5e5ba",
          "FontSize": 10,
