  "CategoryIcon": "imgs/crown",
  "Icon": "imgs/plugin",
  "CodePath": "bin/plugin.cjs",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "PropertyInspectorPath": "ui/inspector.html",
  "URL": "https://crazybatto.de",
