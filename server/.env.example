# Alle echten Werte ausschließlich in der privaten .env oder im Dienstmanager.
PUBLIC_ORIGIN=https://example.invalid
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
TRUST_PROXY=0

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=
OWNER_DISCORD_ID=

# 64 zufällige Hex-Zeichen; dauerhaft privat sichern.
TOKEN_ENCRYPTION_KEY=

# Eigenes E-Mail-Auth-Projekt mit aktivierter Bestätigungs-E-Mail.
ACCOUNT_SUPABASE_URL=
ACCOUNT_SUPABASE_PUBLISHABLE_KEY=

# UUID des registrierten, bestätigten, lokal freigegebenen Betreiberkontos.
BATTO_SUITE_OWNER_ID=

# Optionale Medien-/Musikdienste
MUSIC_BOT_ENABLED=0
MUSIC_STORAGE_URL=
MUSIC_STORAGE_TOKEN=

# Optionale, separat bereitgestellte private/öffentliche App-Artefakte.
# Die Control-Center-Installer und persönlichen APKs werden hier nicht veröffentlicht.
APK_VERSION=2.3.0
APK_PATH=
CHAT_APP_APK_PATH=
MUSIC_REMOTE_APK_PATH=
CHAT_APP_SIGNER_SHA256=
CONTROL_APP_SIGNER_SHA256=

