{
  "name": "crazybatto-discord-admin",
  "version": "3.7.0",
  "private": true,
  "description": "Crazy_Batto Control Center für Windows mit Website-Bot und SFTP-Dateimanager",
  "author": "Crazy_Batto",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node electron/local-build-companion.cjs && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "npm run build && electron-builder --win nsis portable --x64",
    "package:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "vite": "8.3.7"
  },
  "build": {
    "appId": "de.crazybatto.discordadmin",
    "productName": "CrazyBatto Control Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/assets/app-icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "CrazyBatto-Control-Center.exe"
    },
    "nsis": {
      "artifactName": "CrazyBatto-Control-Center-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrazyBatto Control Center",
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "runAfterFinish": true
    }
  }
}
